# ShrotiHost site — runtime environment (read by the Next.js server process).
# Copy to .env.local for local dev. In production these live in the systemd
# unit for shrotihost-next; CAREERS_CSV_FILE and PROJECT_ENQUIRIES_CSV_FILE
# are REQUIRED there (the intake APIs answer 503 "not_configured" otherwise).

# Absolute path of the job-applications CSV. Must be outside the deployed app
# dir and any web root; the route creates dir 0700 / file 0600.
CAREERS_CSV_FILE=/home/shrotihost/shared-data/job-applications.csv

# Absolute path of the project-enquiries CSV (same rules as above).
PROJECT_ENQUIRIES_CSV_FILE=/home/shrotihost/shared-data/project-enquiries.csv

# Daily WHMCS TLD pricing export (JSON). Falls back to the static catalog in
# src/lib/domains.ts when missing or malformed.
TLD_PRICING_FILE=/home/shrotihost/shared-data/tld-pricing.json

# Optional: HTTPS endpoint that receives a JSON summary (no IP/UA) of every
# stored application/enquiry, fire-and-forget with a 3 s timeout.
# ENQUIRY_WEBHOOK_URL=https://example.invalid/hooks/enquiries
